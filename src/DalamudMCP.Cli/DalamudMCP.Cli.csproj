<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DalamudMCP.Cli</RootNamespace>
    <AssemblyName>DalamudMCP.Cli</AssemblyName>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <PackageType>McpServer</PackageType>
    <ToolCommandName>dalamudmcp</ToolCommandName>
    <PackageId>DalamudMCP.Cli</PackageId>
    <Authors>Garume</Authors>
    <Description>Windows-local MCP server and CLI bridge for a running FFXIV session through Dalamud.</Description>
    <PackageTags>ffxiv;ff14;dalamud;mcp;mcp-server;model-context-protocol</PackageTags>
    <PackageProjectUrl>https://github.com/getsetmind/DalamudMCP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/getsetmind/DalamudMCP.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Manifold" Version="1.0.0" />
    <PackageReference Include="Manifold.Cli" Version="1.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DalamudMCP.Protocol\DalamudMCP.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Link="README.md" />
    <None Include="..\..\.mcp\server.json" Pack="true" PackagePath=".mcp/server.json" Link=".mcp/server.json" />
  </ItemGroup>
</Project>
