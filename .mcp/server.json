{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.getsetmind/dalamudmcp",
  "title": "DalamudMCP",
  "description": "Observe a local FFXIV session through Dalamud and run explicitly enabled game actions.",
  "version": "1.1.0",
  "websiteUrl": "https://github.com/getsetmind/DalamudMCP",
  "repository": {
    "url": "https://github.com/getsetmind/DalamudMCP",
    "source": "github",
    "subfolder": "src/DalamudMCP.Cli"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "DalamudMCP.Cli",
      "version": "1.1.0",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        },
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
